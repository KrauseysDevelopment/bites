# --- Secrets -------------------------------------------------------------
# The USDA FoodData Central key lives here. GitHub secret-scans public repos
# and USDA deactivates keys it finds published, so this must never be pushed.
# Secrets.example.plist IS committed as the template.
Bites/Secrets.plist

